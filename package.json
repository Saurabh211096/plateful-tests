{
  "name": "plateful-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Automated tests for Plateful (Kestrel Bay Technologies QA team)",
  "scripts": {
    "test": "playwright test",
    "test:phone": "playwright test --project=phone",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-test-hygiene.mjs",
    "ci": "npm run lint && npm run typecheck && playwright test --list"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3"
  }
}
